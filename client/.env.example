# Base URL of the API. In development the Vite proxy forwards /api to http://localhost:5000.
# In production set the full URL, e.g. https://tally-api.example.com/api
VITE_API_URL=/api

# Origin used for Socket.IO and uploaded images. Leave empty to use the same origin as the page.
# In production set it to the API origin, e.g. https://tally-api.example.com
VITE_SERVER_URL=
