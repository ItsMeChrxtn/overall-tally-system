# ---------- Server ----------
PORT=5050
NODE_ENV=development

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/overall_tally

# ---------- Auth ----------
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ---------- CORS / links ----------
# Comma-separate multiple origins
CLIENT_URL=http://localhost:5180

# ---------- Mail (optional: used for "forgot password") ----------
# When SMTP_HOST is empty, reset links are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Overall Tally <no-reply@example.com>"

# ---------- Uploads ----------
MAX_UPLOAD_MB=3
